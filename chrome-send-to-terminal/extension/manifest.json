{
  "manifest_version": 3,
  "name": "Send to Terminal",
  "version": "1.0.0",
  "description": "Right-click selected text, a link, or a page and send it to macOS Terminal to run as root after confirmation.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "nativeMessaging", "notifications"],
  "background": {
    "service_worker": "background.js"
  }
}
